      "typeVersion": 2,
      "position": [
        1740,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId } = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (staticData.drafts) delete staticData.drafts[chatId];\nreturn [{ json: { chatId } }];"
      }
    },
    {
      "id": "T13",
      "name": "Send Cancel",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1960,
        320
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "🗑️ Draft cancelled. Send a new post idea whenever you're ready.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "T14",
      "name": "Build Edit Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, text, postText, fbPhotoIds, originalBrief } = $input.first().json;\nconst system = \"You are the social media content creator for SkyHouse Sayulita, a luxury vacation rental in Sayulita Mexico. Write Facebook posts that get published automatically.\\n\\nSkyHouse: 3 bed/3 bath/sleeps 8, panoramic ocean views, shared infinity pool, private tennis court, Starlink WiFi, 3-min walk to beach. Host E\\u00f1o offers surf lessons, boat charters, ATV tours.\\n\\nBRAND VOICE: Elegant, experiential, warm. Plain text only. No markdown. No nightly rates. Never claim private beach or private pool. 100-200 words. Hashtags at end only.\\n\\nOutput ONLY the post text. No explanations, no questions, no commentary.\";\nconst content = 'Original request: ' + originalBrief + '\\n\\nCurrent draft:\\n' + postText + '\\n\\nUser feedback: ' + text + '\\n\\nRewrite incorporating this feedback. Output only the post text.';\nconst requestBody = JSON.stringify({ model: 'claude-opus-4-6', max_tokens: 1024, system, messages: [{ role: 'user', content }] });\nreturn [{ json: { chatId, fbPhotoIds, originalBrief, postText, requestBody } }];"
      }
    },
    {
      "id": "T15",
      "name": "Call Claude for Edit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1960,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.requestBody }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_ANTHROPIC",
          "name": "Anthropic API"
        }
      }
    },
    {
      "id": "T16",
      "name": "Parse & Store Edit Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst prev = $('Build Edit Request').first().json;\nlet postText = '';\nif (response.content && response.content[0]) postText = response.content[0].text.trim();\nif (!postText) throw new Error('Claude returned empty response');\nconst staticData = $getWorkflowStaticData('global');\nconst drafts = staticData.drafts || {};\ndrafts[prev.chatId] = { postText, fbPhotoIds: prev.fbPhotoIds, originalBrief: prev.originalBrief, pending: true };\nstaticData.drafts = drafts;\nreturn [{ json: { chatId: prev.chatId, postText } }];"
      }
    },
    {
      "id": "T17",
      "name": "Detect Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { text, chatId } = $input.first().json;\nconst lower = (text || '').toLowerCase().trim();\nlet intent = 'create_post';\nif (['/start','/help','help','hi','hello'].includes(lower)) intent = 'help';\nelse if (['status','report','/status'].includes(lower)) intent = 'status';\nreturn [{ json: { intent, text, chatId } }];"
      }
    },
    {
      "id": "T18",
      "name": "Is Post Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        460
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.intent }}",
              "rightValue": "create_post",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "T19",
      "name": "Is Help?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1520,
        580
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.intent }}",
              "rightValue": "help",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
