      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1960,
        140
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "={{ $('Prep Post').first().json.chatId }}",
        "text": "={{ '✅ Posted to SkyHouse Facebook!\\n\\n' + $('Prep Post').first().json.postText }}",
