        2180,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst { chatId, originalBrief } = $('Analyze Brief').first().json;\nconst files = items\n  .filter(f => f && !f.IsDirectory && (f.Length > 0 || f.ContentLength > 0))\n  .map(f => ({ cdnUrl: 'https://SkyhouseSayulita.b-cdn.net/' + f.ObjectName }));\nif (files.length === 0) throw new Error('No photos in SkyHouse storage');\nconst selected = [...files].sort(() => Math.random() - 0.5).slice(0, Math.min(3, files.length));\nreturn selected.map((p, i) => ({ json: { photoIndex: i, cdnUrl: p.cdnUrl, chatId, originalBrief } }));"
      }
    },
    {
      "id": "T28",
      "name": "Upload Photo to Facebook",
