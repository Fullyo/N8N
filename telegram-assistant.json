      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_BUNNY_SAYULITA",
          "name": "Bunny Sayulita Shared"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://la.storage.bunnycdn.com/sayulitaandbeyond/' + $('Analyze Brief').first().json.sayulitaFolder + '/' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "T25",
      "name": "Pick 3 Sayulita",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst { chatId, originalBrief, sayulitaFolder } = $('Analyze Brief').first().json;\nconst files = items\n  .filter(f => f && !f.IsDirectory && (f.Length > 0 || f.ContentLength > 0))\n  .map(f => ({ cdnUrl: 'https://sayulitaandbeyond.b-cdn.net/' + sayulitaFolder + '/' + f.ObjectName }));\nif (files.length === 0) throw new Error('No photos in Sayulita/' + sayulitaFolder);\nconst selected = [...files].sort(() => Math.random() - 0.5).slice(0, Math.min(3, files.length));\nreturn selected.map((p, i) => ({ json: { photoIndex: i, cdnUrl: p.cdnUrl, chatId, originalBrief } }));"
      }
    },
