{
  "name": "Fullyo — Telegram AI Assistant",
  "nodes": [
    {
      "id": "t001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        400
      ],
      "webhookId": "fullyo-telegram-assistant",
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "updates": [
          "message"
        ]
      }
    },
    {
      "id": "t002",
      "name": "Security Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const msg = $input.first().json;\nconst OWNER_ID = 8609472348;\nconst fromId = msg.message?.from?.id;\nconst text = msg.message?.text || '';\nconst chatId = String(msg.message?.chat?.id || '');\nconst authorized = fromId === OWNER_ID;\nreturn [{ json: { authorized, chatId, text, fromId } }];"
      }
    },
    {
      "id": "t003",
      "name": "Is Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        400
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "t004",
      "name": "Detect Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { text, chatId } = $input.first().json;\nconst lower = (text || '').toLowerCase().trim();\nlet intent = 'create_post';\nif (['/start','/help','help','hi','hello'].includes(lower)) intent = 'help';\nelse if (['status','report','/status'].includes(lower)) intent = 'status';\nreturn [{ json: { intent, text, chatId } }];"
      }
    },
    {
      "id": "t005",
      "name": "Is Post Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.intent }}",
              "rightValue": "create_post",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "t006",
      "name": "Is Help?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        480
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.intent }}",
              "rightValue": "help",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "t007",
      "name": "Send Help",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1560,
        420
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "👋 *Fullyo AI Assistant* — ready.\n\nJust describe what you want to post:\n\n_\"Post about waking up to ocean views at SkyHouse\"_\n_\"Surf post about the five best breaks near Sayulita\"_\n\nI'll pick photos, write the caption, and post to Facebook.\n\nType *status* for automation status.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "t008",
      "name": "Send Status",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1560,
        560
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "📊 *Fullyo — Automation Status*\n\n✅ SkyHouse Sayulita — Daily Facebook posts active\n⏳ Moroccan Palace — Not yet set up\n\n✅ Bunny CDN · ✅ Claude AI · ✅ Facebook API",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "t009",
      "name": "Ignore Unauthorized",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        900,
        520
      ],
      "parameters": {}
    },
    {
      "id": "t010",
      "name": "List SkyHouse Photos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_BUNNY_SKYHOUSE",
          "name": "Bunny SkyHouse Storage"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "https://la.storage.bunnycdn.com/skyhousesayulita/",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "accept",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "t011",
      "name": "Pick 3 Photos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst chatId = $('Is Post Request?').first().json.chatId;\nconst text = $('Is Post Request?').first().json.text;\nconst files = items\n  .filter(f => f && !f.IsDirectory && (f.Length > 0 || f.ContentLength > 0))\n  .map(f => ({ objectName: f.ObjectName, cdnUrl: 'https://SkyhouseSayulita.b-cdn.net/' + f.ObjectName }));\nif (files.length === 0) throw new Error('No photos found in SkyHouse storage');\nconst shuffled = [...files].sort(() => Math.random() - 0.5);\nconst selected = shuffled.slice(0, Math.min(3, shuffled.length));\nreturn selected.map((p, i) => ({ json: { photoIndex: i, cdnUrl: p.cdnUrl, objectName: p.objectName, chatId, originalBrief: text } }));"
      }
    },
    {
      "id": "t012",
      "name": "Upload Photo to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_FACEBOOK",
          "name": "SkyHouse Facebook Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/1004908006045909/photos",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.cdnUrl }}"
            },
            {
              "name": "published",
              "value": "false"
            }
          ]
        }
      }
    },
    {
      "id": "t013",
      "name": "Collect Photo IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uploads = $input.all();\nconst chatId = $('Pick 3 Photos').first().json.chatId;\nconst originalBrief = $('Pick 3 Photos').first().json.originalBrief;\nconst fbPhotoIds = uploads.map(u => u.json.id || u.json.photo_id).filter(Boolean);\nif (fbPhotoIds.length === 0) throw new Error('No photos uploaded to Facebook');\nreturn [{ json: { chatId, originalBrief, fbPhotoIds } }];"
      }
    },
    {
      "id": "t014",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const system = \"You are the social media content creator for SkyHouse Sayulita, a luxury vacation rental in Sayulita Mexico.\\n\\nSkyHouse: 3 bed/3 bath/sleeps 8, panoramic ocean views, shared infinity pool, private tennis court, Starlink WiFi, 3-min walk to beach. Host E\\u00f1o offers surf lessons, boat charters, ATV tours.\\n\\nBRAND VOICE: Elegant, experiential, warm. Plain text only. No markdown. No nightly rates. Never claim private beach or private pool. 100-200 words. Hashtags at end only.\\n\\nOutput ONLY the post text. No explanations, no questions, no commentary.\";\nconst { chatId, originalBrief, fbPhotoIds } = $input.first().json;\nconst requestBody = JSON.stringify({\n  model: 'claude-opus-4-6',\n  max_tokens: 1024,\n  system,\n  messages: [{ role: 'user', content: originalBrief }]\n});\nreturn [{ json: { chatId, originalBrief, fbPhotoIds, requestBody } }];"
      }
    },
    {
      "id": "t015",
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2440,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_ANTHROPIC",
          "name": "Anthropic API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.requestBody }}"
      }
    },
    {
      "id": "t016",
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_FACEBOOK",
          "name": "SkyHouse Facebook Token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/1004908006045909/feed",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ message: $('Call Claude').first().json.content[0].text.trim(), attached_media: $('Collect Photo IDs').first().json.fbPhotoIds.map(id => ({ media_fbid: id })) }) }}"
      }
    },
    {
      "id": "t017",
      "name": "Send Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2880,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "={{ $('Collect Photo IDs').first().json.chatId }}",
        "text": "={{ '✅ Posted to SkyHouse Facebook!\\n\\n' + $('Call Claude').first().json.content[0].text.trim() }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "t018",
      "name": "Weekly Status Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        620
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 14 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "t019",
      "name": "Send Weekly Summary",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        460,
        620
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "8609472348",
        "text": "☀️ *Good morning Seb — Weekly Check-in*\n\n✅ SkyHouse posted daily this week\n\nReply with any post idea and I'll publish it instantly.\n\n_Have a great week!_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    }
  ],
