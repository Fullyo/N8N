{
  "name": "Fullyo — Telegram AI Assistant",
  "nodes": [
    {
      "id": "T01",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        400
      ],
      "webhookId": "fullyo-telegram-assistant",
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "updates": [
          "message"
        ]
      }
    },
    {
      "id": "T02",
      "name": "Security Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const msg = $input.first().json;\nconst OWNER_ID = 8609472348;\nconst fromId = msg.message?.from?.id;\nconst text = msg.message?.text || '';\nconst chatId = String(msg.message?.chat?.id || '');\nreturn [{ json: { authorized: fromId === OWNER_ID, chatId, text } }];"
      }
    },
    {
      "id": "T03",
      "name": "Is Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        640,
        400
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "T04",
      "name": "Ignore Unauthorized",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        860,
        540
      ],
      "parameters": {}
    },
    {
      "id": "T05",
      "name": "Check State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, text } = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nconst draft = (staticData.drafts || {})[chatId] || {};\nif (draft.pending) {\n  return [{ json: { mode: 'confirm', chatId, text,\n    postText: draft.postText, fbPhotoIds: draft.fbPhotoIds, originalBrief: draft.originalBrief } }];\n}\nreturn [{ json: { mode: 'new', chatId, text } }];"
      }
    },
    {
      "id": "T06",
      "name": "Is Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1080,
        320
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.mode }}",
              "rightValue": "confirm",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "T07",
      "name": "Is Yes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.text.toLowerCase().trim() }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ]
        }
      }
    },
    {
      "id": "T08",
      "name": "Prep Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, postText, fbPhotoIds } = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (staticData.drafts) delete staticData.drafts[chatId];\nreturn [{ json: { chatId, postText, fbPhotoIds } }];"
      }
    },
    {
      "id": "T09",
      "name": "Post Approved to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1740,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/1004908006045909/feed",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ message: $json.postText, attached_media: $json.fbPhotoIds.map(id => ({ media_fbid: id })) }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_FACEBOOK",
          "name": "SkyHouse Facebook Token"
        }
      }
    },
    {
      "id": "T10",
