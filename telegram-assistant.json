      "typeVersion": 1.1,
      "position": [
        240,
        400
      ],
      "webhookId": "fullyo-telegram-assistant",
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
