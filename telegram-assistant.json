      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { callbackQueryId, chatId, text } = $input.first().json;\nconst action = text; // 'post_confirm', 'edit_request', 'cancel_post'\nconst staticData = $getWorkflowStaticData('global');\nconst drafts = staticData.drafts || {};\nconst draft = drafts[chatId] || {};\nreturn [{ json: { action, chatId, callbackQueryId, postText: draft.postText || '', fbPhotoIds: draft.fbPhotoIds || [], originalBrief: draft.originalBrief || '' } }];"
      }
