    {
      "id": "t025",
      "name": "Pick 3 Photos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all().map(i => i.json);\nconst chatId = $('Is Post Request?').first().json.chatId;\nconst text = $('Is Post Request?').first().json.text;\nconst files = items\n  .filter(f => f && !f.IsDirectory && (f.Length > 0 || f.ContentLength > 0))\n  .map(f => ({ objectName: f.ObjectName, cdnUrl: 'https://SkyhouseSayulita.b-cdn.net/' + f.ObjectName }));\nif (files.length === 0) throw new Error('No photos found in SkyHouse storage');\nconst shuffled = [...files].sort(() => Math.random() - 0.5);\nconst selected = shuffled.slice(0, Math.min(3, shuffled.length));\nreturn selected.map((photo, idx) => ({ json: { photoIndex: idx, cdnUrl: photo.cdnUrl, objectName: photo.objectName, chatId, originalBrief: text } }));"
      }
    },
