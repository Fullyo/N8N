      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uploads = $input.all();\nconst { chatId, originalBrief } = $('Analyze Brief').first().json;\nconst fbPhotoIds = uploads.map(u => u.json.id || u.json.photo_id).filter(Boolean);\nif (fbPhotoIds.length === 0) throw new Error('No photos uploaded to Facebook');\nreturn [{ json: { chatId, originalBrief, fbPhotoIds } }];"
      }
    },
    {
      "id": "T30",
      "name": "Build Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2840,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, originalBrief, fbPhotoIds } = $input.first().json;\nconst system = \"You are the social media content creator for SkyHouse Sayulita, a luxury vacation rental in Sayulita Mexico. Write Facebook posts that get published automatically.\\n\\nSkyHouse: 3 bed/3 bath/sleeps 8, panoramic ocean views, shared infinity pool, private tennis court, Starlink WiFi, 3-min walk to beach. Host E\\u00f1o offers surf lessons, boat charters, ATV tours.\\n\\nBRAND VOICE: Elegant, experiential, warm. Plain text only. No markdown. No nightly rates. Never claim private beach or private pool. 100-200 words. Hashtags at end only.\\n\\nOutput ONLY the post text. No explanations, no questions, no commentary.\";\nconst requestBody = JSON.stringify({\n  model: 'claude-opus-4-6', max_tokens: 1024, system,\n  messages: [{ role: 'user', content: originalBrief }]\n});\nreturn [{ json: { chatId, originalBrief, fbPhotoIds, requestBody } }];"
      }
    },
