    {
      "id": "t016",
      "name": "Build Claude Request (Edit)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, feedback, originalBrief, fbPhotoIds } = $input.first().json;\nconst system = \"You are the social media content creator for SkyHouse Sayulita, a luxury vacation rental in Sayulita Mexico. Write Facebook posts that get published automatically.\\n\\nSkyHouse: 3 bed/3 bath/sleeps 8, panoramic ocean views, shared infinity pool, private tennis court, Starlink WiFi, 3-min walk to beach. Host Eño offers surf lessons, boat charters, ATV tours.\\n\\nBRAND VOICE: Elegant, experiential, warm. Plain text only. No markdown. No nightly rates. Never claim private beach or private pool. 100-200 words. Hashtags at end only.\\n\\nOutput ONLY the post text. No explanations, no questions, no commentary.\";\nconst content = 'Original request: ' + originalBrief + '\\n\\nUser feedback: ' + feedback + '\\n\\nPlease rewrite the post incorporating this feedback. Output only the post text, nothing else.';\nconst requestBody = JSON.stringify({ model: 'claude-opus-4-6', max_tokens: 1024, system, messages: [{ role: 'user', content }] });\nreturn [{ json: { chatId, originalBrief, fbPhotoIds, requestBody } }];"
      }
    },
    {
      "id": "t017",
      "name": "Regenerate with Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        500
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRED_ID_ANTHROPIC",
          "name": "Anthropic API"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.requestBody }}"
      }
    },
    {
      "id": "t018",
      "name": "Parse & Store Draft (Edit)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst { chatId, fbPhotoIds, originalBrief } = $('Build Claude Request (Edit)').first().json;\nlet postText = '';\nif (response.content && response.content[0]) { postText = response.content[0].text.trim(); }\nif (!postText) throw new Error('Claude returned empty response');\nconst staticData = $getWorkflowStaticData('global');\nconst drafts = staticData.drafts || {};\ndrafts[chatId] = { postText, fbPhotoIds, originalBrief, awaitingEdit: false };\nstaticData.drafts = drafts;\nreturn [{ json: { chatId, postText, fbPhotoIds } }];"
      }
    },
    {
      "id": "t019",
      "name": "Detect Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        740
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { text, chatId } = $input.first().json;\nconst lower = (text || '').toLowerCase().trim();\nlet intent = 'create_post';\nif (lower === '/start' || lower === '/help' || lower === 'help' || lower === 'hi' || lower === 'hello') { intent = 'help'; }\nelse if (lower === 'status' || lower === 'report' || lower === '/status') { intent = 'status'; }\nreturn [{ json: { intent, text, chatId } }];"
      }
    },
