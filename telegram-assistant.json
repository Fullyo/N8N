      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.isExperience }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "T24",
