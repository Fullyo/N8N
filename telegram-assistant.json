        "text": "={{ '📝 Here\\'s your draft:\\n\\n' + $json.postText + '\\n\\n---\\nReply *YES* to post, describe changes to edit, or *NO* to cancel.' }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
