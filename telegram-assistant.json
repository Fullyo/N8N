    {
      "id": "t014",
      "name": "Check Edit Mode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, text } = $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nconst drafts = staticData.drafts || {};\nconst draft = drafts[chatId] || {};\nif (draft.awaitingEdit) {\n  draft.awaitingEdit = false;\n  drafts[chatId] = draft;\n  staticData.drafts = drafts;\n  return [{ json: { mode: 'edit', chatId, feedback: text, originalBrief: draft.originalBrief || '', fbPhotoIds: draft.fbPhotoIds || [] } }];\n}\nreturn [{ json: { mode: 'new', chatId, text } }];"
      }
    },
