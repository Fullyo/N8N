      "name": "Parse & Store Draft (New)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const response = $input.first().json;\nconst { chatId, fbPhotoIds, originalBrief } = $('Collect Photo IDs').first().json;\nlet postText = '';\nif (response.content && response.content[0]) { postText = response.content[0].text.trim(); }\nif (!postText) throw new Error('Claude returned empty response');\nconst staticData = $getWorkflowStaticData('global');\nconst drafts = staticData.drafts || {};\ndrafts[chatId] = { postText, fbPhotoIds, originalBrief, awaitingEdit: false };\nstaticData.drafts = drafts;\nreturn [{ json: { chatId, postText, fbPhotoIds } }];"
      }
    },
