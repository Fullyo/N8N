      },
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "👋 *Fullyo AI Assistant* — ready.\n\nDescribe any post and I'll pick the right photos and write the caption:\n\n📝 _\"Surf post about the five best breaks near Sayulita\"_ → surf folder photos\n📝 _\"Post about waking up to ocean views at SkyHouse\"_ → SkyHouse photos\n\nYou'll see a preview before anything is posted.\n\nType *status* for automation status.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "T21",
      "name": "Send Status",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1740,
        640
      ],
      "credentials": {
        "telegramApi": {
          "id": "CRED_ID_TELEGRAM",
          "name": "Fullyo Telegram Bot"
        }
      },
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "📊 *Fullyo — Automation Status*\n\n✅ SkyHouse Sayulita — Daily Facebook posts active\n⏳ Moroccan Palace — Not yet set up\n\n✅ Bunny CDN · ✅ Claude AI · ✅ Facebook API",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "T22",
      "name": "Analyze Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { text, chatId } = $input.first().json;\nconst lower = text.toLowerCase();\nconst folderMap = [\n  ['surf','Surf'],['yoga','Yoga'],['restaurant','Restaurants'],['food','Restaurants'],\n  ['dining','Restaurants'],['fishing','Fishing Charter'],['whale','Whale Tours'],\n  ['boat','Ally Cat'],['charter','Ally Cat'],['sup','SUP'],['paddle','SUP'],\n  ['golf','Golf'],['monkey mountain','Monkey Mountain'],['mountain','Monkey Mountain'],\n  ['jungle','Monkey Mountain'],['hike','Monkey Mountain'],['marieta','Marieta Islands'],\n  ['island','Marieta Islands'],['cultural','Local Cultural']\n];\nlet sayulitaFolder = null;\nfor (const [kw, folder] of folderMap) {\n  if (lower.includes(kw)) { sayulitaFolder = folder; break; }\n}\nconst isExperience = sayulitaFolder !== null;\nreturn [{ json: { chatId, originalBrief: text, isExperience, sayulitaFolder } }];"
      }
    },
    {
      "id": "T23",
      "name": "Is Experience Post?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1740,
        460
