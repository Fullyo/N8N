    {
      "id": "t027",
      "name": "Collect Photo IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const uploads = $input.all();\nconst chatId = $('Pick 3 Photos').first().json.chatId;\nconst originalBrief = $('Pick 3 Photos').first().json.originalBrief;\nconst fbPhotoIds = uploads.map(item => item.json.id || item.json.photo_id).filter(Boolean);\nif (fbPhotoIds.length === 0) throw new Error('No photos uploaded to Facebook');\nreturn [{ json: { chatId, originalBrief, fbPhotoIds } }];"
      }
    },
    {
      "id": "t028",
      "name": "Build Claude Request (New)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        700
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { chatId, originalBrief, fbPhotoIds } = $input.first().json;\nconst system = \"You are the social media content creator for SkyHouse Sayulita, a luxury vacation rental in Sayulita Mexico. Write Facebook posts that get published automatically.\\n\\nSkyHouse: 3 bed/3 bath/sleeps 8, panoramic ocean views, shared infinity pool, private tennis court, Starlink WiFi, 3-min walk to beach. Host Eño offers surf lessons, boat charters, ATV tours.\\n\\nBRAND VOICE: Elegant, experiential, warm. Plain text only. No markdown. No nightly rates. Never claim private beach or private pool. 100-200 words. Hashtags at end only.\\n\\nOutput ONLY the post text. No explanations, no questions, no commentary.\";\nconst requestBody = JSON.stringify({ model: 'claude-opus-4-6', max_tokens: 1024, system, messages: [{ role: 'user', content: originalBrief }] });\nreturn [{ json: { chatId, originalBrief, fbPhotoIds, requestBody } }];"
      }
    },
